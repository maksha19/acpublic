# Copy to .env.local (git-ignored) and paste the ApiUrl from the CDK deploy output.
#
#   cd ../ac-infra && cdk deploy      →  Outputs: AC2027-Poc-dev.ApiUrl = https://…/dev
#
# No trailing slash. Vite only exposes variables prefixed with VITE_ to the
# browser bundle — which also means anything you put here is PUBLIC. Never put a
# secret in this file: GitHub Pages requires a public repository.
VITE_API_BASE=https://REPLACE_ME.execute-api.ap-southeast-1.amazonaws.com/dev
