# Copy to .env.local (git-ignored) for local `npm run dev`. Point it at the dev
# API (below) or at ../ac-infra's local server (see ../LOCAL-DEV.md).
#
# No trailing slash. Vite only exposes variables prefixed with VITE_ to the
# browser bundle — which also means anything you put here is PUBLIC. Never put
# a secret in this file.
#
# Deployed builds do not read this file or .env.local; they read the committed
# .env.production (dev values on master, prd values on the prd branch).
VITE_API_BASE=https://api-dev.district80ac.com
