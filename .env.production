# Loaded by `vite build` only (production mode) — this is what the Cloudflare
# Workers Build uses, since the git-ignored .env.local never reaches CI.
# Committed on purpose: the API base URL is public by definition (it ships in
# the JS bundle); no secrets belong in this file.
#
# Currently the DEV backend. When prd is deployed (./deploy.sh prd in
# ../ac-infra), switch to https://api.district80ac.com and push.
VITE_API_BASE=https://api-dev.district80ac.com
